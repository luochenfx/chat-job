<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.chatjob</groupId>
    <artifactId>chat-job</artifactId>
    <version>0.1.0</version>
    <name>chat-job</name>
    <description>BOSS 直聘求职投递自动化（单机自用）</description>

    <properties>
        <java.version>21</java.version>
        <!-- 与 patchright-core 1.62.1 对齐；不得降到 1.51（该版本 locator.count() 存在缺陷） -->
        <playwright.version>1.62.0</playwright.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <sqlite.version>3.45.1.0</sqlite.version>
        <jna.version>5.14.0</jna.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 迁移：Flyway 社区版对 SQLite 的支持在 core 内，不需要独立模块 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <!--
              剔除 driver-bundle：它是一份 202MB 的 jar，里面装着 4 个平台的 node
              （linux / linux-arm64 / mac / mac-arm64 / win32_x64），而本项目根本不用它——
              真正干活的是 build/patchright-driver 里的 patchright driver（由
              -Dplaywright.cli.dir 指过去），node 由 runtime/node.exe 或 PATH 提供。

              不剔除的代价很直接：fat jar 250MB，剔除后约 48MB，分发包小一半以上。
              副作用只有一个：driver 不可用且 fail-closed=false 时不能退回官方 driver，
              BrowserSession 里已把那条路径改成显式报错。回归点见
              scripts/build-dist.mjs 的打包前自检与 README「分发」一节。
            -->
            <exclusions>
                <exclusion>
                    <groupId>com.microsoft.playwright</groupId>
                    <artifactId>driver-bundle</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- DPAPI：Windows 数据保护 API，用于加密 API Key 与 Cookie -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
              控制台产物注入：console/.output/public -> target/classes/public。
              不放在 src/main/resources 下，是为了不让构建产物进源码树（否则每次构建
              都有一堆 hash 文件名污染 git 状态）。目录不存在时本执行会跳过，因此
              只跑后端（mvn test / spring-boot:run 且未构建前端）不受影响。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-console</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/public</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../console/.output/public</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
