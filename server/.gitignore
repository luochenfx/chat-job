# ============================================================
# server/ —— Spring Boot 后端（Maven）
# 只保留源码：pom.xml + src/{main,test}
# ============================================================

# Maven 构建输出
target/
*.class
*.jar
*.war

# 运行时目录兜底。
# 数据落点已由 chat-job.home 锚定到项目根（见 ProjectHome），正常情况下这里不会再生出
# data/ 与 browser-data/；规则保留是为了万一（例如手工改动配置）也不把这类目录带进版本库。
data/
browser-data/
*.orphan-*/

# Maven 本地元数据
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# 后端本地环境变量
.env
.env.*
!.env.example
*.log
